# Local Python tools (no LLM): pip install -r requirements.txt
# Used by read_barcodes.py (zxing-cpp), ocr_batch.py (EasyOCR), crop_book.py (SAM + opencv)

# Neon Postgres (same database as the main repo) — required for matching (non-dry-run) and commit
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech:5432/varietybookhouse?sslmode=require

# Cloudflare R2 — required for commit (image uploads)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=products
R2_PUBLIC_URL=https://your-r2-account-id.r2.cloudflarestorage.com

# Web UI port
WEB_PORT=4173
